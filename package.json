{
  "name": "kulturo",
  "private": true,
  "version": "4.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/release.mjs --check",
    "build": "vite build && node scripts/prepare-dist.mjs",
    "verify": "npm run typecheck && npm run check && npm run build",
    "release": "npm run verify && node scripts/release.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
